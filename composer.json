{
  "name": "nadar/pdf-generator",
  "description": "Pixel-perfect template-overlay PDF generation on top of TCPDF and FPDI.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "pdf",
    "tcpdf",
    "fpdi",
    "template",
    "print",
    "generation"
  ],
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*",
    "ext-zlib": "*",
    "tecnickcom/tcpdf": "6.11.*",
    "setasign/fpdi": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "autoload": {
    "psr-4": {
      "Nadar\\PdfGenerator\\": "src/"
    },
    "files": [
      "src/bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Nadar\\PdfGenerator\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/pdf-generator"
  ],
  "config": {
    "sort-packages": true
  }
}
